# Copy to .env and edit.

# CDP endpoint of the dedicated browser used by the bridge.
CHATGPT_BRIDGE_CDP_URL=http://localhost:9222

# Where the MCP server listens.
#   Same machine as Hermes/client -> 127.0.0.1 (safest)
#   Different machine             -> 0.0.0.0 (use a private network + token)
CHATGPT_BRIDGE_HOST=127.0.0.1
CHATGPT_BRIDGE_PORT=8765

# Optional bearer token. Strongly recommended when binding beyond localhost.
# Generate one: python -c "import secrets;print(secrets.token_urlsafe(32))"
CHATGPT_BRIDGE_TOKEN=

# HTTP header used to identify the calling Hermes profile automatically.
# Keep this aligned with the identity_header.name in Hermes MCP config.
CHATGPT_BRIDGE_IDENTITY_HEADER=X-Hermes-Profile

# Persistent named-session registry. Each Hermes profile is mapped to its own
# ChatGPT conversation id here. The file survives server/repository restarts.
CHATGPT_BRIDGE_SESSION_FILE=~/.pro-bridge/sessions.json

# Optional model slug for NEW chats. Leave empty to use ChatGPT's normal
# account/default behavior. The bridge does not require or enforce GPT Pro.
CHATGPT_MODEL_SLUG=

# Max seconds to wait for files selected in ChatGPT's composer to become ready.
CHATGPT_BRIDGE_UPLOAD_TIMEOUT=180

# Max seconds to wait for one complete answer.
CHATGPT_BRIDGE_TIMEOUT=1800

# Legacy PRO_BRIDGE_* and GPT_PRO_MODEL_SLUG environment variables are still
# accepted for backward compatibility with the upstream project.
